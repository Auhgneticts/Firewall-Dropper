<Window x:Class="FirewallDropper.Views.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firewall Dropper – Rules" Icon="{StaticResource AppIcon}"
        Width="1000" Height="600" MinWidth="680" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Firewall rules" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}" FontSize="13"
                       Text="Rules created by Firewall Dropper. They are kept in Windows Defender Firewall under the group “Firewall Dropper”, so they stay in place whether or not this app is running." />
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" TextChanged="Search_Changed" VerticalContentAlignment="Center" />
                <TextBlock x:Name="SearchHint" Text="Search programs…" IsHitTestVisible="False" Margin="12,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <StackPanel.Resources>
                    <!-- Fluent doesn't dim custom button content when disabled; do it here. -->
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>
                <Button Click="Refresh_Click" Margin="0,0,6,0" ToolTip="Refresh">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button x:Name="EnableButton" Click="Enable_Click" Margin="0,0,6,0" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Turn on" />
                    </StackPanel>
                </Button>
                <Button x:Name="DisableButton" Click="Disable_Click" Margin="0,0,6,0" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Turn off" />
                    </StackPanel>
                </Button>
                <Button x:Name="RemoveButton" Click="Remove_Click" Margin="0,0,6,0" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Remove" />
                    </StackPanel>
                </Button>
                <Button x:Name="RemoveAllButton" Click="RemoveAll_Click" Content="Remove all…" />
            </StackPanel>
        </Grid>

        <!-- Rule list -->
        <Grid Grid.Row="2">
            <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                      HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False"
                      SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Program" Width="2*" SortMemberPath="Rule.ProgramName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,4">
                                    <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Rule.ProgramName}" VerticalAlignment="Center" ToolTip="{Binding Rule.ProgramPath}" />
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="12" Margin="6,0,0,0"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding MissingVisibility}"
                                               ToolTip="This program is no longer at this location." />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Direction" Binding="{Binding Rule.DirectionText}" Width="Auto" />
                    <DataGridTemplateColumn Header="Action" Width="Auto" SortMemberPath="Rule.ActionText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="Action" Text="{Binding Rule.ActionText}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Rule.ActionText}" Value="Allow">
                                        <Setter TargetName="Action" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Networks" Binding="{Binding Rule.ProfilesText}" Width="Auto" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Rule.EnabledText}" Width="Auto" />
                    <DataGridTextColumn Header="Added" Binding="{Binding Rule.CreatedText}" Width="Auto" SortMemberPath="Rule.Created" />
                    <DataGridTextColumn Header="Path" Binding="{Binding Rule.ProgramPath}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="&#xE83D;" Style="{StaticResource Glyph}" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No rules yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" MaxWidth="360"
                           Text="Drag a program or its shortcut onto the Firewall Dropper icon to add one." />
            </StackPanel>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center">
                <Hyperlink Click="OpenWindowsFirewall_Click">Open Windows Defender Firewall</Hyperlink>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
