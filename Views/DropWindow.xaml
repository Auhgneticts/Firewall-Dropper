<Window x:Class="FirewallDropper.Views.DropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FirewallDropper.Views"
        Title="Firewall Dropper" Icon="{StaticResource AppIcon}"
        Width="620" SizeToContent="Height" MaxHeight="760"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Image Source="{StaticResource AppIcon}" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}" />
            </StackPanel>
        </Grid>

        <!-- What will be created -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="ChipCaption" Text="Rules that will be created" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                <WrapPanel x:Name="ChipPanel" />
                <TextBlock x:Name="ChangeSettingsLink" Margin="0,6,0,0" FontSize="12">
                    <Hyperlink Click="ChangeSettings_Click">Change settings</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Dropped programs -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="380" Margin="0,4,0,0">
            <ItemsControl x:Name="ItemsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:DropItem}">
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                    <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="Glyph" Grid.Column="2" Text="{Binding StatusGlyph}" Style="{StaticResource Glyph}"
                                           Margin="12,0,0,0" FontSize="18" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Ready">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Working">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Done">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Warning">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Invalid">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Message bar -->
        <Border x:Name="MessageBar" Grid.Row="3" Style="{StaticResource Card}" Padding="14,10" Margin="0,6,0,0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="MessageGlyph" Style="{StaticResource Glyph}" Margin="0,0,12,0" />
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="520" />
            </StackPanel>
        </Border>

        <!-- Quick toggle for the "confirm before adding" setting -->
        <CheckBox x:Name="AskFirstBox" Grid.Row="4" Margin="2,12,0,0" FontSize="12"
                  Content="Show this list and wait for OK before adding programs"
                  Click="AskFirst_Click" />

        <!-- Buttons -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ViewRulesButton" Content="View rules" Visibility="Collapsed" Click="ViewRules_Click" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="120" Visibility="Collapsed" />
                <TextBlock x:Name="ShieldHint" Style="{StaticResource Caption}" VerticalAlignment="Center" Visibility="Collapsed"
                           Text="Windows will ask for administrator permission." />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="OK" MinWidth="100" IsDefault="True" Margin="0,0,8,0"
                        Style="{DynamicResource AccentButtonStyle}" Click="Ok_Click" />
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="100" IsCancel="True" Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
