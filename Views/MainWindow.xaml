<Window x:Class="FirewallDropper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firewall Dropper" Icon="{StaticResource AppIcon}"
        Width="760" Height="850" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Margin="8,4,8,0" Background="Transparent">
            <MenuItem Header="_App" SubmenuOpened="AppMenu_Opened">
                <MenuItem x:Name="MenuInstall" Header="_Install on this PC…" Click="Install_Click" />
                <MenuItem x:Name="MenuUninstall" Header="_Uninstall…" Click="Uninstall_Click" />
                <Separator />
                <MenuItem x:Name="MenuDesktop" Header="_Desktop shortcut" IsCheckable="True" Click="DesktopShortcut_Click" />
                <MenuItem x:Name="MenuSendTo" Header="Add to right-click “_Send to” menu" IsCheckable="True" Click="SendTo_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Rules">
                <MenuItem Header="_View firewall rules…" Click="ViewRules_Click" />
                <MenuItem Header="Open Windows Defender _Firewall" Click="OpenWindowsFirewall_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Firewall Dropper" Click="About_Click" />
            </MenuItem>
        </Menu>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,16,32,24" MaxWidth="820">

                <!-- Header -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Image Source="{StaticResource AppIcon}" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Firewall Dropper" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Caption}" FontSize="13"
                                   Text="Drag a program or its shortcut onto the Firewall Dropper icon and these settings are applied to it in Windows Firewall." />
                    </StackPanel>
                </Grid>

                <!-- Rules to create -->
                <TextBlock Text="Rules for dropped programs" Style="{StaticResource SectionTitle}" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="20" Margin="0,0,16,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Inbound connections" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Other devices or the internet connecting in to the program." Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ComboBox x:Name="InboundBox" Grid.Column="2" Width="190" VerticalAlignment="Center"
                                  SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="Block" />
                            <ComboBoxItem Content="Allow" />
                            <ComboBoxItem Content="Don't add a rule" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" FontSize="20" Margin="0,0,16,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Outbound connections" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="The program connecting out to your network or the internet." Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ComboBox x:Name="OutboundBox" Grid.Column="2" Width="190" VerticalAlignment="Center"
                                  SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="Block" />
                            <ComboBoxItem Content="Allow" />
                            <ComboBoxItem Content="Don't add a rule" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE968;" Style="{StaticResource Glyph}" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Network profiles" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Which kinds of network the rules apply to." Style="{StaticResource Caption}" />
                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox x:Name="DomainBox" Content="Domain (work)" Margin="0,0,24,0" Click="Setting_Changed" />
                                <CheckBox x:Name="PrivateBox" Content="Private (home)" Margin="0,0,24,0" Click="Setting_Changed" />
                                <CheckBox x:Name="PublicBox" Content="Public (cafés, airports)" Click="Setting_Changed" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8AB;" Style="{StaticResource Glyph}" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="If a program already has a Firewall Dropper rule" Style="{StaticResource CardTitle}" />
                            <RadioButton x:Name="ReplaceRadio" GroupName="Existing" Margin="0,8,0,0" Click="Setting_Changed"
                                         Content="Replace it with these settings" />
                            <RadioButton x:Name="SkipRadio" GroupName="Existing" Margin="0,4,0,0" Click="Setting_Changed"
                                         Content="Keep the existing rule and skip" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="20" Margin="0,0,16,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Confirm before adding" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Show the list of dropped programs and wait for OK. When off, rules are added straight away and only the results are shown." />
                        </StackPanel>
                        <CheckBox x:Name="ConfirmBox" Grid.Column="2" VerticalAlignment="Center" Click="Setting_Changed" />
                    </Grid>
                </Border>

                <Border x:Name="ValidationCard" Style="{StaticResource Card}" Visibility="Collapsed"
                        Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA39;" Style="{StaticResource Glyph}" Margin="0,0,12,0"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        <TextBlock x:Name="ValidationText" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Drop zone -->
                <TextBlock Text="Add programs" Style="{StaticResource SectionTitle}" />

                <Grid x:Name="DropZone" AllowDrop="True" MinHeight="120"
                      DragEnter="DropZone_DragOver" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop">
                    <Rectangle x:Name="DropZoneBorder" RadiusX="8" RadiusY="8" StrokeThickness="1.5" StrokeDashArray="4 3"
                               Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                               Fill="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,16">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Text="Drop programs or shortcuts here" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,8,0,2" />
                        <TextBlock Style="{StaticResource Caption}" TextAlignment="Center"
                                   Text="Or drop them onto the Firewall Dropper desktop shortcut, or right-click a program › Send to › Firewall Dropper." />
                    </StackPanel>
                </Grid>

                <Border x:Name="ShortcutTip" Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" Margin="0,0,16,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"
                                   Text="There's no Firewall Dropper shortcut on your desktop yet. Create one so you can drop programs onto it." />
                        <Button Grid.Column="2" Content="Create desktop shortcut" Click="CreateDesktopShortcut_Click" />
                    </Grid>
                </Border>

                <!-- Footer -->
                <Grid Margin="2,16,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SavedText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Text="Changes are saved automatically." />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center">
                        <Run x:Name="RuleCountRun" Text="" />
                        <Hyperlink Click="ViewRules_Click">View rules</Hyperlink>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
